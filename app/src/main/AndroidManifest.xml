<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.badmintoncourtmanager">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BadmintonCourtManager">
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activity.MainActivity" />
        <activity android:name=".activity.RegisterActivity" />
        <activity android:name=".activity.FieldManagementActivity" />
        <activity android:name=".activity.ServiceManagementActivity" />
        <activity android:name=".activity.BookingManagementActivity" />
        <activity android:name=".activity.AddEditFieldActivity" />
        <activity android:name=".activity.AddEditServiceActivity" />
        <activity android:name=".activity.AddEditBookingActivity" />
        <activity android:name=".activity.BookingDetailActivity" />
        <activity android:name=".activity.StatisticsActivity" />
        <activity android:name=".activity.HelpActivity" />
        <activity android:name=".activity.ExpenseManagementActivity" />
        <activity android:name=".activity.AddEditExpenseActivity" />
        <activity android:name=".activity.AvailableFieldsActivity" />
        <activity android:name=".activity.TransactionHistoryActivity" />
    </application>

</manifest>